# syntax=docker/dockerfile:1
# Telegram Phase A stubs and fake clock (local stack only). Build context: telegram/stubs.
#   docker build -t oan-telegram-stubs telegram/stubs
# Standard library only: no pip install. The test client id and secret come from the
# environment (OAN_STUBS_CLIENT_ID, OAN_STUBS_CLIENT_SECRET), generated by the stack's
# init script; nothing secret is baked in.
# Same pinned base image as the repository's Dockerfile.
ARG PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OAN_STUBS_HOST=0.0.0.0 OAN_STUBS_PORT=8200 OAN_STUBS_CLOCK=running
RUN groupadd --system --gid 10001 stubs \
    && useradd --system --uid 10001 --gid stubs --no-create-home --shell /usr/sbin/nologin stubs
WORKDIR /app
COPY --chown=root:root stubs_server.py seed.json /app/
USER 10001:10001
EXPOSE 8200
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8200/healthz', timeout=2)"]
CMD ["python", "/app/stubs_server.py"]
