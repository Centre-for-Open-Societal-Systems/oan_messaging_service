From b29decf6cd6798aeaf1eb7fbb99aed72c910f05e Mon Sep 17 00:00:00 2001
From: OAN trial <trial@example.invalid>
Date: Sun, 15 Nov 2026 20:17:50 +0530
Subject: [PATCH 2/3] Map OTP delivery failures to visible 4xx/5xx on issue
 (consent and aggregation)

---
 .../openg2p_consent_manager/services/aggregator_service.py | 7 ++++++-
 .../openg2p_consent_manager/services/lifecycle_service.py  | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/backend/src/openg2p_consent_manager/services/aggregator_service.py b/backend/src/openg2p_consent_manager/services/aggregator_service.py
index 6d08573..d242286 100644
--- a/backend/src/openg2p_consent_manager/services/aggregator_service.py
+++ b/backend/src/openg2p_consent_manager/services/aggregator_service.py
@@ -227,7 +227,12 @@ class AggregatorService(BaseService):
         # property of the flow.
         request.otp_required = await self._otp_required_for(partner_id)
         if request.otp_required:
-            await self.otp.issue(request, request.subject_id_value)
+            try:
+                await self.otp.issue(request, request.subject_id_value)
+            except OtpError as exc:
+                # The code could not be delivered: refuse the fetch visibly rather
+                # than park it in pending_otp with a code nobody received.
+                raise AggregationError(exc.status, exc.reason, exc.detail) from exc
             request.status = AggregationStatus.pending_otp.value
         else:
             request.status = AggregationStatus.verified.value
diff --git a/backend/src/openg2p_consent_manager/services/lifecycle_service.py b/backend/src/openg2p_consent_manager/services/lifecycle_service.py
index 914363f..5a7b652 100644
--- a/backend/src/openg2p_consent_manager/services/lifecycle_service.py
+++ b/backend/src/openg2p_consent_manager/services/lifecycle_service.py
@@ -158,7 +158,12 @@ class LifecycleService(BaseService):
             # carrying its failures forward would punish the wrong code.
             req.otp_attempts = 0
             req.otp_verified_at = None
-            await self.otp.issue(req, req.subject_id_value)
+            try:
+                await self.otp.issue(req, req.subject_id_value)
+            except OtpError as exc:
+                # e.g. no phone for the subject, or the SMS service unavailable:
+                # nothing is stored, the subject sees why and can ask again.
+                raise LifecycleError(exc.status, exc.reason) from exc
             await session.commit()
             await session.refresh(req)
             return req
-- 
