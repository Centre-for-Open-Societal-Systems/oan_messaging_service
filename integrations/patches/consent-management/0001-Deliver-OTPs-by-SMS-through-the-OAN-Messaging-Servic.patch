+def request(**kw):
+    base = dict(id="req-1", correlation_id=None, partner_id="partner-1",
+                subject_id_value="FIN-1001", otp_channel=None,
+                otp_expires_at=datetime.now(timezone.utc) + timedelta(seconds=300))
+    base.update(kw)
+    return types.SimpleNamespace(**base)
