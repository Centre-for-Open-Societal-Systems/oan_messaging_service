index 0000000..ed25827
--- /dev/null
+++ b/backend/src/openg2p_consent_manager/services/sms_length.py
@@ -0,0 +1,17 @@
+"""One-SMS-part rule, identical to the OAN Messaging Service's check.
+
+OAN refuses text that does not fit one part, so the OTP text is measured before it is sent.
+"""
+
+GSM7_BASIC = frozenset(
+    "@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞÆæßÉ !\"#¤%&'()*+,-./0123456789:;<=>?"
+    "¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà"
+)
+GSM7_EXTENSION = frozenset("^{}\\[~]|€\f")
+
+
+def fits_one_sms(text: str) -> bool:
+    """Same rule OAN enforces: 160 GSM-7 septets (extension chars = 2), else 70 UTF-16."""
+    if all(c in GSM7_BASIC or c in GSM7_EXTENSION for c in text):
+        return sum(2 if c in GSM7_EXTENSION else 1 for c in text) <= 160
+    return len(text.encode("utf-16-le")) // 2 <= 70
diff --git a/backend/tests/test_oan_otp_delivery.py b/backend/tests/test_oan_otp_delivery.py
index 8d2b709..a2c7c32 100644
--- a/backend/tests/test_oan_otp_delivery.py
+++ b/backend/tests/test_oan_otp_delivery.py
@@ -105,3 +105,33 @@ async def test_disabled_delivery_sends_nothing(cfg, monkeypatch):
     monkeypatch.setattr(otp_delivery._config, "oan_delivery_enabled", False, raising=False)
     assert await otp_delivery.deliver_otp(request(), "482913") is None
     assert not cfg.requests
+
