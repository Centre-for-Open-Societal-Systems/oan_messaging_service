+def render_otp_text(kind: str, code: str, partner: str, minutes: int) -> str:
+    """The OTP text, guaranteed to fit one SMS part (OAN refuses anything longer)."""
+    text = TEMPLATES[kind].format(code=code, partner=partner, minutes=minutes)
+    if fits_one_sms(text):
+        return text
+    short = SHORT_TEMPLATES[kind].format(code=code, minutes=minutes)
+    if fits_one_sms(short):
+        return short
+    raise _otp_error(500, "otp_text_too_long", "the OTP text does not fit one SMS part")
